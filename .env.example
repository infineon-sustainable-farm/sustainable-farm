POSTGRES_DB=sustainable_farm
POSTGRES_USER=farm_admin
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Backend
# Set to "dev" to load reference data (stops, workshops, slots, activities, ...)
# and the Site Security demo data (gates, credentials, access logs).
# Leave empty in production.
SPRING_PROFILES_ACTIVE=
# Comma-separated origins allowed to call the API (frontend dev / container).
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Site Security API access. Generate each token with: openssl rand -hex 32
# Each one needs at least 32 characters. A missing or shorter token disables
# that role; with neither token, the Site Security API refuses every request.
SITESECURITY_READ_TOKEN=
SITESECURITY_ADMIN_TOKEN=
