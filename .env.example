POSTGRES_DB=sustainable_farm
POSTGRES_USER=farm_admin
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Backend
# Set to "dev" to load reference data (stops, workshops, slots, activities, ...)
# and the Site Security demo data (gates, credentials, access logs).
# Leave empty in production.
SPRING_PROFILES_ACTIVE=
# Comma-separated origins allowed to call the API (frontend dev / container).
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Site Security API access. Generate each token with: openssl rand -hex 32
# Each one needs at least 32 characters. A missing or shorter token disables
# that role; with neither token, the Site Security API refuses every request.
SITESECURITY_READ_TOKEN=
SITESECURITY_ADMIN_TOKEN=
# Email of the first Site Security admin, created at startup if it does not
# exist yet. That admin then adds the other operators.
SITESECURITY_BOOTSTRAP_ADMIN_EMAIL=

# Email. Docker Compose sends every email to Mailpit, a test server that keeps
# them and delivers none: read them at http://localhost:8025.
# Leave these commented to use Mailpit. To send real email, set MAIL_HOST,
# MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD and MAIL_FROM to your SMTP relay.
# MAIL_ENABLED=true
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_USERNAME=mailpit
# MAIL_PASSWORD=mailpit
# MAIL_FROM=visits@sustainable-farm.local
# Local ports for Mailpit, if 8025 or 1025 is already in use.
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025



