POSTGRES_DB=sustainable_farm
POSTGRES_USER=farm_admin
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Backend
# Set to "dev" to load reference data (stops, workshops, slots, activities, ...)
# and the Site Security demo data (gates, credentials, access logs).
# Leave empty in production.
SPRING_PROFILES_ACTIVE=
# Comma-separated origins allowed to call the API (frontend dev / container).
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Site Security. Operators sign in with their email and a 6-digit code sent by
# email; the session lasts 8 hours. Open the app at an address listed in
# APP_CORS_ORIGINS: changes are refused from any other origin.
# Email of the first Site Security admin, created at startup if it does not
# exist yet. That admin then adds the other operators.
SITESECURITY_BOOTSTRAP_ADMIN_EMAIL=
# Key used to hash sign-in codes. Generate it with: openssl rand -hex 32
# It needs at least 32 characters; without it, no sign-in code can be issued.
SITESECURITY_OTP_SECRET=
# Token of the gate scanner, the only device that does not sign in.
# Generate it with: openssl rand -hex 32. Leave it empty to disable the scanner.
SITESECURITY_GATE_TOKEN=
# The session cookie is sent over HTTPS only (browsers also accept it on
# http://localhost). Set to false only to open the app over plain HTTP from
# another machine.
# SITESECURITY_COOKIE_SECURE=true

# Email. Docker Compose sends every email to Mailpit, a test server that keeps
# them and delivers none: read them at http://localhost:8025.
# Leave these commented to use Mailpit. To send real email, set MAIL_HOST,
# MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD and MAIL_FROM to your SMTP relay.
# MAIL_ENABLED=true
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_USERNAME=mailpit
# MAIL_PASSWORD=mailpit
# MAIL_FROM=visits@sustainable-farm.local
# Local ports for Mailpit, if 8025 or 1025 is already in use.
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025



