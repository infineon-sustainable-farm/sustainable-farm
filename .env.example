# Copy to .env and adjust. Never commit .env. Values below are local placeholders, not secrets.

# PostgreSQL (postgres service of docker-compose.yml)
POSTGRES_DB=sustainable_farm
POSTGRES_USER=farm_admin
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Backend database connection (read by application.properties, no defaults).
# docker-compose.yml builds them from the POSTGRES_* values above; set them yourself
# only when running the backend outside Docker.
DB_URL=jdbc:postgresql://localhost:5432/sustainable_farm
DB_USERNAME=farm_admin
DB_PASSWORD=changeme

# Backend
# Set to "dev" to load reference data (stops, workshops, slots, activities, ...).
# Leave empty in production.
SPRING_PROFILES_ACTIVE=
# Comma-separated origins allowed to call the API (app.cors.allowed-origins).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Farm site coordinates used by the weather features (app.weather.latitude / longitude).
WEATHER_LATITUDE=10.63
WEATHER_LONGITUDE=-4.77

# Optional: real e-mail delivery (app.mail.enabled / app.mail.from, read through Spring
# relaxed binding). Disabled when unset. Enabling it also needs the SMTP server settings
# (SPRING_MAIL_HOST, SPRING_MAIL_PORT, SPRING_MAIL_USERNAME, SPRING_MAIL_PASSWORD).
# APP_MAIL_ENABLED=true
# APP_MAIL_FROM=no-reply@example.org

# Frontend build (docker-compose.yml build arg). Empty: the frontend calls the API on
# its own origin (nginx proxy).
VITE_API_URL=
